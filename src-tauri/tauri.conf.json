{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Écho",
  "version": "0.1.0",
  "identifier": "com.echo.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Écho — Notes",
        "url": "/",
        "width": 960,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480
      },
      {
        "label": "quick",
        "title": "Écho — Dictée",
        "url": "/",
        "width": 400,
        "height": 170,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}